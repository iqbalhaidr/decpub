# ---- Testnet confirmation (Sepolia) ----
# Copy this file to ".env" and fill in the values. NEVER commit ".env".

# RPC endpoint for Sepolia (free tier: Alchemy / Infura / public RPC)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Private key of a throwaway wallet funded with a little Sepolia ETH (from a faucet).
# Use a DEDICATED test wallet — never a wallet holding real funds.
PRIVATE_KEY=0xyour_test_wallet_private_key

# Optional: escrow size for the confirmation batch (default 0.01 ETH).
ESCROW_ETH=0.01

# Optional: Etherscan API key to publish/verify contract source.
ETHERSCAN_API_KEY=

# Optional: 4 alamat reviewer tetap untuk demo (dipisah koma). Kalau kosong,
# server memakai 4 alamat default. Author auto-terisi daftar ini; halaman
# Reviewer bisa "act as" salah satunya tanpa MetaMask.
DEMO_REVIEWERS=
