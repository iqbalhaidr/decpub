# Jaringan: "localhost" (Hardhat node) atau "sepolia"
NETWORK=localhost
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Hanya dipakai untuk Sepolia (M13). Jangan commit nilai asli.
# Gunakan kunci deployer BARU. Jangan pakai kunci dari Ciko/ignition/parameters.json (sudah bocor).
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=

# Storage publik (simulator IPFS, M1). Untuk Kubo: API :5001, gateway :8080 (tanpa "/ipfs").
STORAGE_PORT=8081
STORAGE_HOST=127.0.0.1
STORAGE_DATA_DIR=../../data/storage
STORAGE_MAX_BYTES=52428800
STORAGE_API_URL=http://127.0.0.1:8081
STORAGE_GATEWAY_URL=http://127.0.0.1:8081

# ZK simulasi (M2). Port zk-sim dan alamat yang dipakai klien.
ZK_PORT=8082
ZK_HOST=127.0.0.1
ZK_SIM_URL=http://127.0.0.1:8082
# Operator/relayer gateway = akun node indeks ini (Sepolia: 0, karena satu akun).
OPERATOR_ACCOUNT_INDEX=1
# Kunci penanda tangan layanan. Kosong di lokal = kunci dev turunan (PUBLIK, hanya lokal).
# Di jaringan non-lokal WAJIB diisi dengan kunci baru. ISSUER_ADDRESS opsional (turunan dari kunci penerbit).
ATTESTOR_PRIVATE_KEY=
ISSUER_PRIVATE_KEY=
ISSUER_ADDRESS=

# Escrow dan insentif Hugo (M6). Bawaan: APC 0,01 ETH, timeout macet 90 hari.
# Di Sepolia (M13) timeout dipendekkan karena evm_increaseTime tidak tersedia.
APC_AMOUNT_WEI=10000000000000000
ESCROW_IDLE_TIMEOUT_SECONDS=7776000

# Server NestJS (M3). Port 3001. Swagger di /api.
SERVER_PORT=3001
SERVER_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000
# Akun server: operator (relayer gateway) dan registrar (admin PermanentAccounts = deployer).
# Lokal diambil dari node (indeks). Sepolia: isi kunci privat.
REGISTRAR_ACCOUNT_INDEX=0
OPERATOR_PRIVATE_KEY=
REGISTRAR_PRIVATE_KEY=
DB_PATH=../data/server.sqlite
PRIVATE_STORE_DIR=../data/private
# Kunci AES storage privat (32 byte hex). Kosong di lokal = kunci dev. Wajib di jaringan publik.
PRIVATE_STORE_KEY=
# Wajib di jaringan publik. Lokal kosong = rahasia dev.
JWT_SECRET=
PLAGIARISM_THRESHOLD=30
# M7: true. Sesi baru menunggu APC terikat (POST /escrow/bind) sebelum P03. false = perilaku M3-M5 (tanpa escrow).
ESCROW_REQUIRED=true
# QoS q2/q3: hanya "simulated" (heuristik tanpa model bahasa)
QOS_PROVIDER=simulated
AUTO_ADVANCE=true
# Audit trail: blok awal pembacaan log dan lebar jendela eth_getLogs (isi blok deploy di Sepolia)
LOG_FROM_BLOCK=0
LOG_WINDOW=5000
SEED_DEMO_ACCOUNTS=true
