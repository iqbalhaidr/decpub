{
    "name": "anonymize-publication-contracts",
    "version": "1.0.0",
    "description": "Smart contract workspace for the Anonymize Publication platform, implementing distributed ledger functions that support publication integrity, review workflows, and verifiable process records.",
    "author": "Francisco Trianto",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "compile": "hardhat compile",
        "test": "hardhat test test/*.test.ts",
        "test:local": "hardhat test test/*.test.ts",
        "test:deployed": "hardhat test test-deployed/*.test.ts",
        "test:all": "hardhat test test/*.test.ts test-deployed/*.test.ts",
        "test:gas": "hardhat test test/*.test.ts --gas-stats",
        "deploy:local": "hardhat ignition deploy ignition/modules/FullSystem.ts --network localhost",
        "deploy:sepolia": "hardhat ignition deploy ignition/modules/FullSystem.ts --network sepolia",
        "node": "hardhat node"
    },
    "devDependencies": {
        "@nomicfoundation/hardhat-ignition": "^3.1.5",
        "@nomicfoundation/hardhat-toolbox-viem": "^5.0.5",
        "@types/node": "^22.8.5",
        "forge-std": "foundry-rs/forge-std#v1.9.4",
        "hardhat": "^3.4.5",
        "prettier": "^3.8.3",
        "prettier-plugin-solidity": "^2.3.1",
        "typescript": "~5.8.0",
        "viem": "^2.47.6"
    },
    "dependencies": {
        "@openzeppelin/contracts": "^5.6.1"
    }
}
